@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(CyAudioCore_CYDSP_VERSION "@CYAUDIOCORE_PACKAGE_CYDSP_VERSION@")
if(NOT TARGET CyDSP::CyDSP)
 if(@CYAUDIOCORE_PACKAGE_STRETCH@)
  find_dependency(CyDSP ${CyAudioCore_CYDSP_VERSION} EXACT CONFIG COMPONENTS Stretch)
 else()
  find_dependency(CyDSP ${CyAudioCore_CYDSP_VERSION} EXACT CONFIG)
 endif()
else()
 get_target_property(_cyaudio_dsp_directory CyDSP::CyDSP SOURCE_DIR)
 get_directory_property(_cyaudio_dsp_version
  DIRECTORY "${_cyaudio_dsp_directory}" DEFINITION CyDSP_VERSION)
 if(NOT _cyaudio_dsp_version VERSION_EQUAL CyAudioCore_CYDSP_VERSION)
  set(CyAudioCore_FOUND FALSE)
  set(CyAudioCore_NOT_FOUND_MESSAGE "This CyAudioCore archive requires CyDSP ${CyAudioCore_CYDSP_VERSION}; existing target version is '${_cyaudio_dsp_version}'. Rebuild matching archives and headers.")
  return()
 endif()
endif()
if(@CYAUDIOCORE_PACKAGE_STRETCH@ AND NOT TARGET CyDSP::Stretch)
 set(CyAudioCore_FOUND FALSE)
 set(CyAudioCore_NOT_FOUND_MESSAGE "This build requires CyDSP::Stretch")
 return()
endif()
if(@CYAUDIOCORE_PACKAGE_THREADS@)
    find_dependency(Threads)
endif()
if(@CYAUDIOCORE_PACKAGE_ALSA@)
    find_dependency(ALSA)
endif()
if(@CYAUDIOCORE_PACKAGE_JACK@)
    find_dependency(PkgConfig)
    pkg_check_modules(CYAUDIOCORE_JACK REQUIRED IMPORTED_TARGET jack)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CyAudioCoreTargets.cmake")
foreach(component IN LISTS CyAudioCore_FIND_COMPONENTS)
    if(component STREQUAL "CyAudioCore")
        set(CyAudioCore_${component}_FOUND TRUE)
    elseif(TARGET CyAudioCore::${component})
        set(CyAudioCore_${component}_FOUND TRUE)
    else()
        set(CyAudioCore_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(CyAudioCore)
