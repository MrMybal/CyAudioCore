# Original static-only recipe for the pinned, byte-exact PortAudio sources.
# No upstream SDK discovery, downloads, tests, examples, shared libraries or install rules.
enable_language(C)
set(pa_root "${CMAKE_CURRENT_SOURCE_DIR}/third_party/portaudio")
add_library(CyAudioCorePortAudio STATIC
 ${pa_root}/src/common/pa_allocation.c ${pa_root}/src/common/pa_converters.c
 ${pa_root}/src/common/pa_cpuload.c ${pa_root}/src/common/pa_debugprint.c
 ${pa_root}/src/common/pa_dither.c ${pa_root}/src/common/pa_front.c
 ${pa_root}/src/common/pa_process.c ${pa_root}/src/common/pa_ringbuffer.c
 ${pa_root}/src/common/pa_stream.c ${pa_root}/src/common/pa_trace.c)
set_target_properties(CyAudioCorePortAudio PROPERTIES EXPORT_NAME PrivatePortAudio POSITION_INDEPENDENT_CODE ON)
target_include_directories(CyAudioCorePortAudio PRIVATE ${pa_root}/include ${pa_root}/src/common)
set(CYAUDIOCORE_PA_WASAPI 0)
if(WIN32)
 option(CYAUDIOCORE_PORTAUDIO_WASAPI "PortAudio WASAPI (Windows SDK)" ON)
 option(CYAUDIOCORE_PORTAUDIO_WINMM "PortAudio WinMM (Windows SDK)" ON)
 option(CYAUDIOCORE_PORTAUDIO_DIRECTSOUND "PortAudio DirectSound (Windows SDK)" OFF)
 target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/os/win/pa_win_hostapis.c
  ${pa_root}/src/os/win/pa_win_util.c ${pa_root}/src/os/win/pa_win_waveformat.c
  ${pa_root}/src/os/win/pa_win_coinitialize.c)
 target_include_directories(CyAudioCorePortAudio PRIVATE ${pa_root}/src/os/win)
 target_compile_definitions(CyAudioCorePortAudio PRIVATE _CRT_SECURE_NO_WARNINGS)
 target_link_libraries(CyAudioCorePortAudio PRIVATE winmm ole32 uuid)
 if(MSVC)
  target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/os/win/pa_x86_plain_converters.c)
 endif()
 if(CYAUDIOCORE_PORTAUDIO_WASAPI)
  set(CYAUDIOCORE_PA_WASAPI 1)
  target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/hostapi/wasapi/pa_win_wasapi.c)
  target_compile_definitions(CyAudioCorePortAudio PRIVATE PA_USE_WASAPI=1)
 endif()
 if(CYAUDIOCORE_PORTAUDIO_WINMM)
  target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/hostapi/wmme/pa_win_wmme.c)
  target_compile_definitions(CyAudioCorePortAudio PRIVATE PA_USE_WMME=1)
 endif()
 if(CYAUDIOCORE_PORTAUDIO_DIRECTSOUND)
  target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/hostapi/dsound/pa_win_ds.c ${pa_root}/src/hostapi/dsound/pa_win_ds_dynlink.c)
  target_compile_definitions(CyAudioCorePortAudio PRIVATE PA_USE_DS=1 PAWIN_USE_DIRECTSOUNDFULLDUPLEXCREATE)
  target_link_libraries(CyAudioCorePortAudio PRIVATE dsound)
 endif()
elseif(APPLE OR (UNIX AND NOT ANDROID))
 target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/os/unix/pa_unix_hostapis.c ${pa_root}/src/os/unix/pa_unix_util.c)
 target_include_directories(CyAudioCorePortAudio PRIVATE ${pa_root}/src/os/unix)
 target_link_libraries(CyAudioCorePortAudio PRIVATE Threads::Threads ${CMAKE_DL_LIBS} m)
 if(APPLE)
  option(CYAUDIOCORE_PORTAUDIO_COREAUDIO "PortAudio CoreAudio (Apple SDK)" ON)
  if(CYAUDIOCORE_PORTAUDIO_COREAUDIO)
   target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/hostapi/coreaudio/pa_mac_core.c
    ${pa_root}/src/hostapi/coreaudio/pa_mac_core_blocking.c ${pa_root}/src/hostapi/coreaudio/pa_mac_core_utilities.c)
   target_compile_definitions(CyAudioCorePortAudio PRIVATE PA_USE_COREAUDIO=1)
   target_link_libraries(CyAudioCorePortAudio PRIVATE "-framework CoreAudio" "-framework AudioToolbox"
    "-framework AudioUnit" "-framework CoreFoundation" "-framework CoreServices")
  endif()
 else()
  option(CYAUDIOCORE_PORTAUDIO_ALSA "PortAudio ALSA (requires libasound development package)" ON)
  option(CYAUDIOCORE_PORTAUDIO_JACK "PortAudio JACK (requires JACK development package)" OFF)
  if(CYAUDIOCORE_PORTAUDIO_ALSA)
   find_package(ALSA REQUIRED)
   set(CYAUDIOCORE_PACKAGE_ALSA ON)
   target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/hostapi/alsa/pa_linux_alsa.c)
   target_compile_definitions(CyAudioCorePortAudio PRIVATE PA_USE_ALSA=1)
   target_link_libraries(CyAudioCorePortAudio PRIVATE ALSA::ALSA)
  endif()
  if(CYAUDIOCORE_PORTAUDIO_JACK)
   find_package(PkgConfig REQUIRED)
   pkg_check_modules(CYAUDIOCORE_JACK REQUIRED IMPORTED_TARGET jack)
   set(CYAUDIOCORE_PACKAGE_JACK ON)
   target_sources(CyAudioCorePortAudio PRIVATE ${pa_root}/src/hostapi/jack/pa_jack.c)
   target_compile_definitions(CyAudioCorePortAudio PRIVATE PA_USE_JACK=1)
   target_link_libraries(CyAudioCorePortAudio PRIVATE PkgConfig::CYAUDIOCORE_JACK)
  endif()
 endif()
else()
 message(FATAL_ERROR "PortAudio provider is supported by this recipe on Windows, macOS and desktop Unix only")
endif()
target_sources(CyAudioCoreDevices PRIVATE src/io/PortAudioProvider.cpp)
target_include_directories(CyAudioCoreDevices SYSTEM PRIVATE ${pa_root}/include)
target_compile_definitions(CyAudioCoreDevices PRIVATE CYAUDIOCORE_PA_WASAPI=${CYAUDIOCORE_PA_WASAPI})
target_link_libraries(CyAudioCoreDevices PRIVATE CyAudioCorePortAudio)
install(TARGETS CyAudioCorePortAudio EXPORT CyAudioCoreTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
